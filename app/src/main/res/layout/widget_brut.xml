<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget : vues compatibles RemoteViews uniquement. Le lanceur ne charge pas les polices
  de l'appli : on prend les familles système les plus proches (condensée, à chasse fixe).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.06"
                android:text="@string/widget_brand"
                android:textColor="@color/brut_cream"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_format"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="@string/widget_format_preview"
                android:textColor="@color/brut_amber"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_clip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_recess"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.12"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/widget_clip"
                android:textColor="@color/brut_red"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_chrono_zero"
                android:textColor="@color/brut_cream_faint"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="@string/widget_ready"
                android:textColor="@color/brut_cream_dim"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_level"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_level"
            android:visibility="invisible" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_marker"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/action_marker"
        android:src="@drawable/widget_marker"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_rec"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/tile_record"
        android:src="@drawable/widget_rec_idle" />
</LinearLayout>
