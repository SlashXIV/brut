<?xml version="1.0" encoding="utf-8"?>
<!-- Mis à jour par l'application elle-même pendant la prise : aucune mise à jour périodique. -->
<!-- previewLayout et targetCell* : Android 12+, ignorés avant (minWidth/minHeight prennent le relais). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_brut"
    android:minWidth="250dp"
    android:minHeight="80dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="80dp"
    android:previewLayout="@layout/widget_brut"
    android:resizeMode="horizontal"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
